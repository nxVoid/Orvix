# Checked-in local development defaults. Private credentials and personal
# overrides belong in .env.local or config/env/local.env, both ignored by git.

ORVIX_ENV=development
NODE_ENV=development
ORVIX_BASE_DOMAIN=localhost
ORVIX_PUBLIC_SCHEME=http
ORVIX_PUBLIC_PORT=8088
ORVIX_STATIC_CDN_DOMAIN=localhost
ORVIX_PUBLIC_URL=http://localhost:8088
ORVIX_API_ENDPOINT=http://localhost:8088/api
