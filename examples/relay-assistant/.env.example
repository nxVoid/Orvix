# API base including its actual prefix. Never use a frontend/VITE environment variable for this token.
RELAY_API_URL=http://localhost:8088/api/v1
RELAY_BOT_TOKEN=
# CDN/media base from your Relay instance's discovery response.
RELAY_MEDIA_URL=http://localhost:8088/media
# Comma-separated guild IDs where this bot is already installed via OAuth2.
RELAY_GUILD_IDS=
