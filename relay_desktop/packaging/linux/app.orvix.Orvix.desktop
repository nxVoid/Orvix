# SPDX-License-Identifier: AGPL-3.0-or-later
[Desktop Entry]
Name=Relay
GenericName=Instant Messenger
Comment=Instant messaging and VoIP
Exec=app.orvix.Orvix %U
TryExec=app.orvix.Orvix
Icon=app.orvix.Orvix
Type=Application
Categories=Network;InstantMessaging;Chat;
Keywords=chat;im;messaging;messenger;voip;voice;video;call;
StartupWMClass=app.orvix.Orvix
SingleMainWindow=true
StartupNotify=true
MimeType=x-scheme-handler/relay;x-scheme-handler/orvix;
Terminal=false
X-GNOME-UsesNotifications=true
Actions=open-settings;new-dm;

[Desktop Action open-settings]
Name=Open Settings
Exec=app.orvix.Orvix --orvix-task=open-settings %U

[Desktop Action new-dm]
Name=New Direct Message
Exec=app.orvix.Orvix --orvix-task=new-dm %U
